# 复制为 .env 后按需填写；也可以什么都不填，启动后在网页「系统设置」里配置。
# 环境变量只用于首次启动时播种默认值，之后以 data/config.json 为准。

# 区域：ovh-ca / ovh-eu / ovh-us
OVH_ENDPOINT=ovh-ca
# 结算子区域：CA / QC / IE / FR / GB / DE / US ...
OVH_SUBSIDIARY=CA

# 在 https://ca.api.ovh.com/createToken/ 生成（权限至少给 GET/POST/PUT/DELETE 的 /*）
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# 面板访问密码，留空则打开即可使用（公网部署强烈建议设置）
PANEL_PASSWORD=

# Telegram 通知
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 数据目录（配置文件与日志），Docker 里默认 /app/data
OVH_DATA_DIR=data
